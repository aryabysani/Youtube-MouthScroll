{
  "manifest_version": 3,
  "name": "MouthScroll",
  "version": "1.0.0",
  "description": "Scroll YouTube Shorts and Instagram Reels hands-free — just open your mouth!",

  "permissions": ["storage"],
  "host_permissions": [
    "*://*.youtube.com/*",
    "*://*.instagram.com/*"
  ],

  "action": {
    "default_popup": "popup.html",
    "default_title": "MouthScroll",
    "default_icon": {
      "16":  "icons/icon16.png",
      "48":  "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/shorts/*",
        "*://*.youtube.com/watch*",
        "*://*.instagram.com/*"
      ],
      "js": [
        "libs/face-api.min.js",
        "content.js"
      ],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],

  "web_accessible_resources": [
    {
      "resources": ["models/*", "libs/*"],
      "matches": ["*://*.youtube.com/*", "*://*.instagram.com/*"]
    }
  ]
}
